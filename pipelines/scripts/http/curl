#!/bin/bash

#############################################################################
# Select tenant authentication without changing existing curl call sites.   #
#############################################################################

generation=$(printf '%s' "${TENANT_GENERATION:-gen1}" | tr '[:upper:]' '[:lower:]')
base_url="${IWHI_BASE_URL:-}"
curl_bin="${IWHI_CURL_BIN:-/usr/bin/curl}"

case "$generation" in
  ""|gen1) generation="gen1" ;;
  gen2) ;;
  *)
    echo "Unsupported tenant generation '${TENANT_GENERATION}'. Expected gen1 or gen2." >&2
    exit 2
    ;;
esac

is_tenant_request=false
if [ -n "$base_url" ]; then
  for argument in "$@"; do
    case "$argument" in
      "${base_url}"|"${base_url}/"*) is_tenant_request=true; break ;;
    esac
  done
fi

if [ "$generation" != "gen2" ] || [ "$is_tenant_request" != "true" ]; then
  exec "$curl_bin" "$@"
fi

instance_api_key="${INSTANCE_API_KEY:-}"
if [ -z "$instance_api_key" ] || [[ "$instance_api_key" == '$('* ]]; then
  echo "A Gen2 tenant requires the secret INSTANCE_API_KEY." >&2
  exit 2
fi

filtered_arguments=()
skip_next=false
for argument in "$@"; do
  if [ "$skip_next" = "true" ]; then
    skip_next=false
    continue
  fi
  case "$argument" in
    -u|--user)
      skip_next=true
      ;;
    --user=*)
      ;;
    *)
      filtered_arguments+=("$argument")
      ;;
  esac
done

# Avoid exposing either Basic credentials from the original arguments or the
# Gen2 key when a caller enabled shell tracing.
xtrace_was_enabled=false
case "$-" in
  *x*) xtrace_was_enabled=true; set +x ;;
esac

"$curl_bin" "${filtered_arguments[@]}" --header "x-instance-api-key: ${instance_api_key}"
status=$?

[ "$xtrace_was_enabled" = "true" ] && set -x
exit "$status"
